# The upstream tests create these files and directories in the current
# working directory. Which of them remain at the end depends on the tests
# that ran last, so their cleanup is optional. Run the tests in declaration
# order, as upstream does.
#
# Skip the test that asserts from multiple threads, which Catch2 does not
# support (data race that can crash the test driver).
#
$* --order decl '~mdc different threads' >| 2>| \
   &?test_logs/*** &?log_tests/*** &?filename_*
